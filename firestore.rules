rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'subscriptionTier']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.subscriptionTier in ['none', 'hourly', 'monthly', 'yearly'] &&
             (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!('steamId' in data) || (data.steamId is string && data.steamId.size() <= 128)) &&
             (!('steamUsername' in data) || (data.steamUsername is string && data.steamUsername.size() <= 100)) &&
             (!('steamProfileUrl' in data) || (data.steamProfileUrl is string && data.steamProfileUrl.size() <= 500)) &&
             (!('steamAvatar' in data) || (data.steamAvatar is string && data.steamAvatar.size() <= 1000)) &&
             (!('steamLinkedAt' in data) || (data.steamLinkedAt is timestamp || data.steamLinkedAt is string)) &&
             (data.keys().hasAll(['createdAt']) ? (data.createdAt is timestamp) : true);
    }
    
    function isValidGameLink(data) {
      return data.keys().hasAll(['gameId', 'title', 'platform']) &&
             data.gameId is string && data.gameId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.platform in ['steam', 'epic', 'gog', 'xbox'] &&
             (data.keys().hasAll(['linkedAt']) ? (data.linkedAt is timestamp) : true);
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['bookingId', 'userId', 'userEmail', 'tier', 'ratePerHour', 'date', 'startTime', 'endTime', 'durationHours', 'totalAmount', 'status']) &&
             data.bookingId is string && data.bookingId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.userEmail is string && data.userEmail.size() <= 256 &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
             data.tier in ['1080p', '1440p', '4K'] &&
             data.ratePerHour is number && data.ratePerHour > 0 &&
             data.date is string && data.date.size() == 10 &&
             data.startTime is string && data.startTime.size() == 5 &&
             data.endTime is string && data.endTime.size() == 5 &&
             data.durationHours is number && data.durationHours > 0 &&
             data.totalAmount is number && data.totalAmount > 0 &&
             data.status in ['confirmed', 'active', 'completed', 'cancelled'] &&
             (data.keys().hasAll(['createdAt']) ? (data.createdAt is timestamp) : true);
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasAny(['subscriptionTier', 'username', 'displayName', 'photoURL', 'steamId', 'steamUsername', 'steamProfileUrl', 'steamAvatar', 'steamLinkedAt']);
      allow delete: if false;
      
      match /games/{gameId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(gameId) && isValidGameLink(incoming()) && incoming().keys().size() <= 5 && incoming().linkedAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /bookings/{bookingId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(bookingId) && isValidBooking(incoming()) && incoming().createdAt == request.time;
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(bookingId) && isValidBooking(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }
    }
  }
}

